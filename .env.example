# Local / Docker secrets — copy to .env and fill in.
# Never commit .env

# MySQL 8 (docker-compose)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=eventpulse
MYSQL_USER=eventpulse
MYSQL_PASSWORD=change-me

# Spring Boot app (docker-compose → app service)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/eventpulse?allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=eventpulse
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8080

# Later phases (leave blank for Phase 0)
# JWT_SECRET=
# MAIL_USERNAME=
# MAIL_PASSWORD=
