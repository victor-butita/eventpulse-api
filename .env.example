# Local / Docker secrets — copy to .env and fill in.
# Never commit .env

# MariaDB (docker-compose)
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=eventpulse
MARIADB_USER=eventpulse
MARIADB_PASSWORD=change-me

# Spring Boot app (docker-compose → app service)
SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/eventpulse?allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=eventpulse
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8080

# Later phases (leave blank for Phase 0)
# JWT_SECRET=
# MAIL_USERNAME=
# MAIL_PASSWORD=
